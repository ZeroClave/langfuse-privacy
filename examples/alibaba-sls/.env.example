# Copy to the integration repository root as .env.sls (ignored by Git).
# Use a dedicated test project/logstore with a runId text index enabled first.
SLS_REGION=cn-hangzhou
SLS_PROJECT=
SLS_LOGSTORE=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional: STS security token. Used for both writing and read-back.
ALIBABA_CLOUD_SECURITY_TOKEN=

SLS_MAX_CONCURRENT_MASKS=4
SLS_READBACK_TIMEOUT_MS=60000
ZEROCLAVE_TIMEOUT_MS=15000
ZEROCLAVE_ENDPOINT=https://zeroclave.com/v1/pii/detect
# Leave DEBUG unset. SDK debug logging can expose signed headers and STS tokens.
