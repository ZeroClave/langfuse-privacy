# Copy to the repository root as .env.cls. The .env.cls copy is ignored by Git.
CLS_DEFAULT_REGION=ap-guangzhou
CLS_TOPIC_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Optional: STS session token, used for BOTH OTLP writing and SearchLog read-back.
TENCENTCLOUD_TOKEN=

# Optional example limits. No original-text fallback when detection fails/is full.
CLS_MAX_CONCURRENT_MASKS=4
CLS_READBACK_TIMEOUT_MS=60000
ZEROCLAVE_TIMEOUT_MS=15000
ZEROCLAVE_ENDPOINT=https://zeroclave.com/v1/pii/detect
